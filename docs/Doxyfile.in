PROJECT_NAME           = ThreadPoolCPP
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "C++20 task execution with explicit lifecycle guarantees"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
INPUT                  = third_party/NOTICE.md README.md docs/guide.md docs/design.md docs/testing.md include/threadpool/thread_pool.hpp
USE_MDFILE_AS_MAINPAGE  = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXCLUDE_SYMBOLS        = threadpool::detail threadpool::detail::*
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
FULL_PATH_NAMES        = NO
